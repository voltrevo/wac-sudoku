// What a player has done to one puzzle, as bytes.
//
// **The answer is not stored, so most of the state costs one bit.** The seed regenerates the
// solution, so a cell filled in *correctly* needs only the fact that it is filled. Only the cells
// the player has got wrong carry a digit, and in a grid being solved rather than guessed at there
// are usually none. What is left is two bit vectors and a short list:
//
//     0        version
//     1-2      a fingerprint of the answer this state was saved against
//     3-7      which cells are filled            36 bits
//     8-34     pencil marks, six bits per cell   216 bits
//     35-37    seconds on the clock              24 bits
//     38       flags — bit 0 `revealed`, bit 1 `solved`
//     39       how many cells are wrong, W
//     40-43    solved at, unix seconds           32 bits, zero if it never was
//     44-46    solved in, seconds on the clock   24 bits
//     47..     one byte each: cell * 6 + digit - 1, which fits because 36 * 6 = 216 < 256
//
// Fifty bytes and a little, against the 285 characters of JSON that said less. The caller never
// looks inside: `webgen.wac` hands this out as an opaque array and takes it back.
//
// **When it was solved and how long it took are kept apart from the running clock**, because Clear
// resets the clock and starting a solved puzzle over should not un-solve it in the history.
//
// Version 1 is still read. It had no completion fields and its wrong-list began at byte 40, so a
// state saved before this is loaded rather than thrown away for being old.

const i32 CELLS = 36;
const i32 VERSION = 2;
const i32 HEAD = 47;
const i32 HEAD_V1 = 40;

/** Where the wrong-list starts, which is the only thing the older layout moved. */
i32 headFor(i32 version) {
  if (version == 1) { return HEAD_V1; }
  return HEAD;
}

void put24(u8[] b, i32 at, i32 v) {
  b[at] = v & 0xff;
  b[at + 1] = (v >>> 8) & 0xff;
  b[at + 2] = (v >>> 16) & 0xff;
}

i32 get24(u8[] b, i32 at) { return b[at] | (b[at + 1] << 8) | (b[at + 2] << 16); }

/**
 * Sixteen bits of the answer, so that a state saved against a *different* answer is thrown away
 * rather than silently rewritten. Nothing pins a seed to the puzzle it produced — change the
 * generator and `brisk-otter-00` is a new grid, and without this the old state would decode
 * against it and quietly move the player's digits around.
 */
i32 fingerprint(i32[] solution) {
  i32 h = 0x9dc5;
  for (i32 i = 0; i < solution.len(); i++) {
    h = (h ^ solution[i]) & 0xffff;
    h = (h * 0x0193) & 0xffff;
  }
  return h;
}

bool wrongAt(i32[] solution, i32[] val, i32 i) {
  return val[i] != 0 && val[i] != solution[i];
}

/** Set bit `at` of the vector starting at byte `from`. */
void setBit(u8[] b, i32 from, i32 at) {
  i32 idx = from + at / 8;
  b[idx] = b[idx] | (1 << (at % 8));
}

bool getBit(u8[] b, i32 from, i32 at) {
  return (b[from + at / 8] & (1 << (at % 8))) != 0;
}

export u8[] encode(i32[] solution, i32[] val, i32[] notes, i32 elapsedMs, bool revealed,
                   i32 solvedAt, i32 solvedIn) {
  i32 wrong = 0;
  for (i32 i = 0; i < CELLS; i++) { if (wrongAt(solution, val, i)) { wrong = wrong + 1; } }

  u8[] b = u8[HEAD + wrong]();
  b[0] = VERSION;
  i32 fp = fingerprint(solution);
  b[1] = fp & 0xff;
  b[2] = (fp >>> 8) & 0xff;

  for (i32 i = 0; i < CELLS; i++) { if (val[i] != 0) { setBit(b, 3, i); } }

  for (i32 i = 0; i < CELLS; i++) {
    i32 m = notes[i];
    for (i32 k = 0; k < 6; k++) { if ((m & (1 << k)) != 0) { setBit(b, 8, i * 6 + k); } }
  }

  // Seconds, not milliseconds: three bytes then hold 194 days, and nobody is timing to the tick.
  put24(b, 35, elapsedMs / 1000);
  i32 flags = 0;
  if (revealed) { flags = flags | 1; }
  if (solvedAt != 0) { flags = flags | 2; }
  b[38] = flags;
  b[39] = wrong;
  b[40] = solvedAt & 0xff;
  b[41] = (solvedAt >>> 8) & 0xff;
  b[42] = (solvedAt >>> 16) & 0xff;
  b[43] = (solvedAt >>> 24) & 0xff;
  put24(b, 44, solvedIn);

  i32 at = HEAD;
  for (i32 i = 0; i < CELLS; i++) {
    if (wrongAt(solution, val, i)) { b[at] = i * 6 + val[i] - 1; at = at + 1; }
  }
  return b;
}

/**
 * The state back, as `36` digits, `36` note masks, seconds, then `revealed`. An empty array means
 * the bytes were not usable — a version this build does not know, a length that does not match its
 * own header, or an answer that is not the one they were saved against. The caller reads that as
 * "no saved state" and starts the puzzle clean, which is the only safe reading of a blob whose
 * meaning cannot be established.
 */
export i32[] decode(i32[] solution, u8[] b) {
  i32[] none = i32[0]();
  if (b.len() < HEAD_V1) { return none; }
  if (b[0] != 1 && b[0] != VERSION) { return none; }
  i32 head = headFor(b[0]);
  i32 fp = fingerprint(solution);
  if (b[1] != (fp & 0xff)) { return none; }
  if (b[2] != ((fp >>> 8) & 0xff)) { return none; }
  i32 wrong = b[39];
  if (b.len() != head + wrong) { return none; }

  i32[] out = i32[CELLS + CELLS + 4]();
  for (i32 i = 0; i < CELLS; i++) { if (getBit(b, 3, i)) { out[i] = solution[i]; } }

  for (i32 k = 0; k < wrong; k++) {
    i32 code = b[head + k];
    i32 cell = code / 6;
    if (cell >= CELLS) { return none; }
    out[cell] = code % 6 + 1;
  }

  for (i32 i = 0; i < CELLS; i++) {
    i32 m = 0;
    for (i32 k = 0; k < 6; k++) { if (getBit(b, 8, i * 6 + k)) { m = m | (1 << k); } }
    out[CELLS + i] = m;
  }

  out[CELLS + CELLS] = get24(b, 35);
  out[CELLS + CELLS + 1] = b[38] & 1;
  if (b[0] == 1) { return out; }
  out[CELLS + CELLS + 2] = b[40] | (b[41] << 8) | (b[42] << 16) | (b[43] << 24);
  out[CELLS + CELLS + 3] = get24(b, 44);
  return out;
}

/**
 * What the history needs, without the answer.
 *
 * Every field here lives in the header, so this reads it straight out of the bytes — no solution,
 * and so no regenerating a hundred puzzles to draw a list. Only the *digits* need the answer, and a
 * list does not show digits.
 *
 * Returns `ok, filled, noted, seconds, revealed, solved, solvedAt, solvedIn`, or an empty array for
 * bytes it cannot read.
 */
export i32[] summary(u8[] b) {
  i32[] none = i32[0]();
  if (b.len() < HEAD_V1) { return none; }
  if (b[0] != 1 && b[0] != VERSION) { return none; }
  if (b.len() != headFor(b[0]) + b[39]) { return none; }

  i32 filled = 0;
  for (i32 i = 0; i < CELLS; i++) { if (getBit(b, 3, i)) { filled = filled + 1; } }
  i32 noted = 0;
  for (i32 i = 0; i < CELLS; i++) {
    for (i32 k = 0; k < 6; k++) {
      if (getBit(b, 8, i * 6 + k)) { noted = noted + 1; k = 6; }
    }
  }

  i32[] out = i32[8]();
  out[0] = 1;
  out[1] = filled;
  out[2] = noted;
  out[3] = get24(b, 35);
  out[4] = b[38] & 1;
  if (b[0] == 1) { return out; }
  out[5] = (b[38] >>> 1) & 1;
  out[6] = b[40] | (b[41] << 8) | (b[42] << 16) | (b[43] << 24);
  out[7] = get24(b, 44);
  return out;
}

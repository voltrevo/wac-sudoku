// Small text helpers shared by the solver, the generator and the renderer.

/** A number as decimal. */
export string digits(i32 n) {
  if (n == 0) { return "0"; }
  i32 v = n;
  if (v < 0) { v = 0 - v; }
  string out = "";
  while (v > 0) {
    i32 d = v % 10;
    out = "0123456789".slice(d, d + 1) + out;
    v = v / 10;
  }
  if (n < 0) { return "-" + out; }
  return out;
}

export bool isSpace(i32 c) { return c == 32 || c == 9 || c == 13; }

/** A decimal string as a number, or -1 if it is not one. */
export i32 toInt(string s) {
  u8[] b = s.toBytes();
  if (b.len() == 0) { return 0 - 1; }
  i32 v = 0;
  for (i32 i = 0; i < b.len(); i++) {
    i32 d = b[i] - '0';
    if (d < 0) { return 0 - 1; }
    if (d > 9) { return 0 - 1; }
    v = v * 10 + d;
  }
  return v;
}

/** One letter per cage, in the order cages are first met. Enough for 88 of them. */
export const string LETTERS =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!$%&*+=?@^~<>";

export string letterFor(i32 g) { return LETTERS.slice(g, g + 1); }
